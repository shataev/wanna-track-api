# Should add this values
# MONGO_URL=
# SECRET_KEY=

# Telegram bot (for account binding link)
# TELEGRAM_BOT_USERNAME=YourBotUsername
# TELEGRAM_BOT_SECRET=optional-secret-for-telegram-bind-endpoint

# Guards POST /api/exchange-rates/update (header X-Admin-Secret); while unset the route answers 404
# ADMIN_SECRET=

# Set to true once the new web and bot are deployed: turns off the legacy cookie and bot-userId logins
# AUTH_ENFORCE=true
